{
  "family": "frontend-backend-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::225410389910:role/aws-service-role/ecs.amazonaws.com/AWSServiceRoleForECS",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "225410389910.dkr.ecr.us-west-1.amazonaws.com/frontend-app:latest",
      "memory": 512,
      "cpu": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ]
    },
    {
      "name": "backend",
      "image": "225410389910.dkr.ecr.us-west-1.amazonaws.com/backend-app:latest",
      "memory": 512,
      "cpu": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
